function submissionMethodLabel(method) {

    const labels = {
        upload: "Upload Evidence",
        url: "Post / Link Evidence",
        text: "Written Evidence"
    };

    return labels[method] || method;
}


function switchSubmissionMethod(method) {

    const fields =
        document.querySelector("#submissionFields");

    if (!fields) return;

    const missionIndex =
        Number(fields.dataset.mission);

    const rule =
        submissionRules[missionIndex] || {};

    if (method === "upload") {

        fields.innerHTML = `

            <label class="submission-field">

                <span>
                    Upload your completed work
                </span>

                <div
                    class="drop-zone"
                    id="dropZone"
                    onclick="document.querySelector('#evidenceFile').click()">

                    <strong>
                        Choose a file or drag it here
                    </strong>

                    <br>

                    <small>
                        ${
                            rule.accepted ||
                            "Documents, images, ZIP files, etc."
                        }
                    </small>

                    <div
                        class="file-name"
                        id="fileName">
                    </div>

                </div>

                <input
                    id="evidenceFile"
                    type="file"
                    accept="${rule.accepted || "*/*"}"
                    style="display:none">

            </label>

            <label class="submission-field">

                <span>
                    What does this file prove?
                </span>

                <textarea
                    id="evidenceNotes"
                    placeholder="Briefly explain what you completed and what someone should inspect..."
                ></textarea>

            </label>
        `;

        const input =
            document.querySelector("#evidenceFile");

        input.addEventListener(
            "change",
            showSelectedFile
        );

        const dropZone =
            document.querySelector("#dropZone");

        dropZone.addEventListener(
            "dragover",
            event => {
                event.preventDefault();
                dropZone.classList.add("dragging");
            }
        );

        dropZone.addEventListener(
            "dragleave",
            () => {
                dropZone.classList.remove("dragging");
            }
        );

        dropZone.addEventListener(
            "drop",
            event => {

                event.preventDefault();

                dropZone.classList.remove(
                    "dragging"
                );

                const files =
                    event.dataTransfer.files;

                if (files.length) {

                    input.files =
                        files;

                    showSelectedFile();
                }
            }
        );
    }


    if (method === "url") {

        fields.innerHTML = `

            <label class="submission-field">

                <span>
                    Public URL / Posted Work
                </span>

                <input
                    id="evidenceURL"
                    type="url"
                    placeholder="https://..."
                    autocomplete="url">

            </label>

