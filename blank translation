/* =========================================================
   STATE
   ========================================================= */

const DEFAULT_STATE = {
    version: 3,
    xp: 0,
    missions: [],
    auditItems: [],
    challengeDays: [],
    streak: 0,
    lastActivity: null,
    submissions: {},
    bossDefeated: false
};

let state = loadState();


/* =========================================================
   SAFE STATE LOADING
   ========================================================= */

function loadState() {

    let saved = {};

    try {
        const raw = localStorage.getItem(STORAGE_KEY);

        if (raw) {
            saved = JSON.parse(raw) || {};
        }
    } catch (error) {
        console.warn("Could not read saved progress.", error);
    }

    const missions =
        Array.isArray(saved.missions)
            ? [...new Set(saved.missions.map(Number))]
            : [];

    const auditItems =
        Array.isArray(saved.auditItems)
            ? [...new Set(saved.auditItems.map(Number))]
            : Array.from(
                {
                    length: Math.min(
                        Number(saved.audit) || 0,
                        document.querySelectorAll(".auditCheck").length || 5
                    )
                },
                (_, i) => i
            );

    const challengeDays =
        Array.isArray(saved.challengeDays)
            ? [...new Set(saved.challengeDays.map(Number))]
            : Array.from(
                {
                    length: Math.min(
                        Number(saved.challenge) || 0,
                        document.querySelectorAll(".challenge-card").length || 8
                    )
                },
                (_, i) => i
            );

    return {
        ...DEFAULT_STATE,
        ...saved,
        missions,
        auditItems,
        challengeDays,
        submissions:
            saved.submissions &&
            typeof saved.submissions === "object"
                ? saved.submissions
                : {}
    };
}


/* =========================================================
   SAVE
   ========================================================= */

function save() {

    state.version = 3;

    state.completed = state.missions.length;
    state.audit = state.auditItems.length;
    state.challenge = state.challengeDays.length;

    try {
        localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify(state)
        );
    } catch (error) {
        console.warn("Could not save progress.", error);
    }
}


/* =========================================================
   INDEXED DB
   Stores actual uploaded files.
   ========================================================= */

let dbPromise = null;

function openEvidenceDB() {

    if (dbPromise) {
        return dbPromise;
    }

    dbPromise = new Promise((resolve, reject) => {

        const request = indexedDB.open(
            DB_NAME,
            DB_VERSION
        );

        request.onupgradeneeded = event => {

            const db = event.target.result;

            if (!db.objectStoreNames.contains("files")) {

                db.createObjectStore(
                    "files",
                    {
                        keyPath: "id"
                    }
                );
            }
        };

        request.onsuccess = event => {
            resolve(event.target.result);
        };

        request.onerror = () => {
            reject(request.error);
        };
    });

    return dbPromise;
}


async function storeEvidenceFile(file, missionIndex) {

    const db = await openEvidenceDB();

    const id =
        "mission-" +
        missionIndex +
        "-" +
        Date.now() +
        "-" +
        crypto.randomUUID();

    const record = {
        id,
        missionIndex,
        name: file.name,
        type: file.type,
        size: file.size,
        uploadedAt: new Date().toISOString(),
        blob: file
    };

    return new Promise((resolve, reject) => {

        const transaction =
            db.transaction(
                ["files"],
                "readwrite"
            );

        transaction.objectStore("files")
            .put(record);

        transaction.oncomplete = () => {
            resolve(record);
        };

        transaction.onerror = () => {
            reject(transaction.error);
        };
    });
}


async function getEvidenceFile(id) {

    const db = await openEvidenceDB();

    return new Promise((resolve, reject) => {

        const transaction =
            db.transaction(
                ["files"],
                "readonly"
            );

        const request =
            transaction.objectStore("files")
                .get(id);

        request.onsuccess = () => {
            resolve(request.result);
        };

        request.onerror = () => {
            reject(request.error);
        };
    });
}


/* =========================================================
   SHA-256 FILE FINGERPRINT
   Helps create a stronger accountability record.
   ========================================================= */

async function hashFile(file) {

    try {

        const buffer =
            await file.arrayBuffer();

        const hashBuffer =
            await crypto.subtle.digest(
                "SHA-256",
                buffer
            );

        return Array.from(
            new Uint8Array(hashBuffer)
        )
        .map(
            byte =>
                byte
                    .toString(16)
                    .padStart(2, "0")
        )
        .join("");

    } catch (error) {

        return null;
    }
}


/* =========================================================
   ACTIVITY / STREAK
   ========================================================= */

function localDateKey(date = new Date()) {

    return [
        date.getFullYear(),
        String(date.getMonth() + 1).padStart(2, "0"),
        String(date.getDate()).padStart(2, "0")
    ].join("-");
}


function dateDifference(a, b) {

    const first =
        new Date(a + "T00:00:00");

    const second =
        new Date(b + "T00:00:00");

    return Math.round(
        (second - first) /
        86400000
    );
}


function recordActivity() {

    const today =
        localDateKey();

    if (!state.lastActivity) {

        state.streak = 1;

    } else {

        const difference =
            dateDifference(
                state.lastActivity,
                today
            );

        if (difference === 1) {

            state.streak++;

        } else if (difference > 1) {

            state.streak = 1;
        }
    }

    state.lastActivity = today;
}


/* =========================================================
   XP
   ========================================================= */

function addXP(amount) {

    state.xp =
        Math.min(
            MAX_XP,
            Math.max(
                0,
                state.xp + amount
            )
        );
}


