                    .toLowerCase()
                    .includes(
                        submissionMethodLabel(method)
                            .toLowerCase()
                            .split(" ")[0]
                    )
            );
        });
}


function showSelectedFile() {

    const input =
        document.querySelector("#evidenceFile");

    const output =
        document.querySelector("#fileName");

    if (!input || !output) return;

    if (input.files.length) {

        const file =
            input.files[0];

        output.textContent =
            `${file.name} — ${formatBytes(file.size)}`;
    }
}


/* =========================================================
   TURN IN EVIDENCE
   ========================================================= */

async function submitEvidence(missionIndex) {

    const fields =
        document.querySelector("#submissionFields");

    if (!fields) return;

    const method =
        detectActiveSubmissionMethod();

    const timestamp =
        new Date().toISOString();

    const submission = {
        missionIndex,
        method,
        submittedAt: timestamp,
        status: "SUBMITTED",
        notes: ""
    };


    /* -------------------------
       UPLOAD
       ------------------------- */

    if (method === "upload") {

        const input =
            document.querySelector("#evidenceFile");

        if (!input || !input.files.length) {

            toast(
                "Evidence Required",
                "Upload the work before turning in this mission."
            );

            return;
        }

        const file =
            input.files[0];

        const hash =
            await hashFile(file);

        const stored =
            await storeEvidenceFile(
                file,
                missionIndex
            );

        submission.fileId =
            stored.id;

        submission.fileName =
            file.name;

        submission.fileSize =
            file.size;

        submission.fileType =
            file.type;

        submission.fileHash =
            hash;

        submission.notes =
            document.querySelector(
                "#evidenceNotes"
            )?.value.trim() || "";
    }


    /* -------------------------
       URL
       ------------------------- */

    if (method === "url") {

        const urlInput =
            document.querySelector("#evidenceURL");

        const url =
            urlInput?.value.trim();

        if (!url) {

            toast(
                "Link Required",
                "Provide the URL where the work can be inspected."
            );

            return;
        }

        let parsed;

        try {

            parsed =
                new URL(url);

        } catch {

            toast(
                "Invalid URL",
                "Enter a complete URL beginning with https://"
            );

            return;
        }

        if (
            parsed.protocol !== "http:" &&
            parsed.protocol !== "https:"
        ) {

            toast(
                "Invalid Link",
                "Use an http:// or https:// URL."
            );

            return;
        }

        submission.url =
            parsed.href;

        submission.notes =
            document.querySelector(
                "#evidenceNotes"
            )?.value.trim() || "";
    }


    /* -------------------------
       WRITTEN WORK
       ------------------------- */

    if (method === "text") {

        const text =
            document.querySelector(
                "#evidenceText"
            )?.value.trim();

        if (!text) {

            toast(
                "Work Required",
                "Write your completed response before turning it in."
            );

            return;
        }

        submission.text =
            text;

        submission.notes =
            document.querySelector(
                "#evidenceNotes"
            )?.value.trim() || "";
    }


    /* -------------------------
       SAVE SUBMISSION
       ------------------------- */

    if (!state.submissions[missionIndex]) {

        state.submissions[missionIndex] = [];
    }

    if (!Array.isArray(
        state.submissions[missionIndex]
    )) {

        state.submissions[missionIndex] = [];
    }

    state.submissions[missionIndex]
        .push(submission);


    /* -------------------------
       CREDIT MISSION
       ------------------------- */

    if (
        !state.missions.includes(
            missionIndex
        )
    ) {

        const card =
            document.querySelectorAll(
                ".mission-card"
            )[missionIndex];

        const reward =
            Number(
                card?.dataset.xp ||
                card?.querySelector(
                    "[data-xp]"
                )?.dataset.xp ||
                100
            );

        state.missions.push(
            missionIndex
        );

        addXP(reward);

        recordActivity();
    }


    save();
    updateAll();
    restoreMissions();

    closeSubmission();

    toast(
        "Work Turned In",
        "Your evidence was recorded. The mission now has an accountability trail."
    );
}


/* =========================================================
   DETERMINE ACTIVE METHOD
   ========================================================= */

function detectActiveSubmissionMethod() {

    const active =
        document.querySelector(
            ".submission-tab.active"
        );

    if (!active) return "upload";

    const text =
        active.textContent
            .toLowerCase();

    if (text.includes("upload")) {
        return "upload";
    }

    if (
        text.includes("link") ||
        text.includes("post")
    ) {
        return "url";
    }

    return "text";
}


