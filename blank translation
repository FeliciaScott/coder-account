    if (method === "text") {

        fields.innerHTML = `

            <label class="submission-field">

                <span>
                    Submit your work
                </span>

                <textarea
                    id="evidenceText"
                    placeholder="Write your completed response, analysis, plan, reflection, or other required work..."
