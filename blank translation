/* =========================================================
   PLAYER
   ========================================================= */

function updatePlayer() {

    const xp =
        state.xp;

    const level =
        Math.min(
            Math.floor(xp / 200) + 1,
            5
        );

    const levelStart =
        (level - 1) * 200;

    const levelEnd =
        level === 5
            ? 1000
            : level * 200;

    const progress =
        level === 5
            ? 100
            : Math.min(
                100,
                Math.round(
                    ((xp - levelStart) /
                    (levelEnd - levelStart)) *
                    100
                )
            );

    const rank =
        xp >= 800
            ? "UNIGNORABLE"
            : xp >= 600
                ? "OPERATOR"
                : xp >= 400
                    ? "BUILDER"
                    : xp >= 200
                        ? "APPRENTICE"
                        : "STARTER";

    const levelEl =
        document.querySelector("#level");

    const xpEl =
        document.querySelector("#xp");

    const missionsEl =
        document.querySelector("#missionsCompleted");

    const streakEl =
        document.querySelector("#streak");

    const progressFill =
        document.querySelector("#progressFill");

    const rankEl =
        document.querySelector("#rank");


    if (levelEl)
        levelEl.textContent =
            level;

    if (xpEl)
        xpEl.textContent =
            xp;

    if (missionsEl)
        missionsEl.textContent =
            state.missions.length;

    if (streakEl)
        streakEl.textContent =
            state.streak;

    if (progressFill)
        progressFill.style.width =
            progress + "%";

    if (rankEl)
        rankEl.textContent =
            rank;
}


/* =========================================================
   OBJECTIVE
   ========================================================= */

function updateObjective() {

    const objective =
        document.querySelector(
            "#objective"
        );

    if (!objective) return;

    const cards =
        document.querySelectorAll(
            ".mission-card"
        );

    let next = -1;

    for (
        let i = 0;
        i < cards.length;
        i++
    ) {

        if (
            !state.missions.includes(i)
        ) {

            next = i;
            break;
        }
    }

    if (next === -1) {

        objective.textContent =
            "All missions submitted. Complete the audit and final challenge.";

        return;
    }

    const title =
        cards[next]
            ?.querySelector("h3")
            ?.textContent ||
        "Next mission";

    objective.textContent =
        title;
}


/* =========================================================
   SCORE
   ========================================================= */

function calculateScore() {

    return Math.min(
        100,
        Math.round(
            (
                state.xp +
                state.auditItems.length * 25
            ) / 10
        )
    );
}


function updateScore() {

    const score =
        calculateScore();

    const scoreValue =
        document.querySelector(
            "#scoreValue"
        );

    const scoreCircle =
        document.querySelector(
            "#scoreCircle"
        );

    const scoreMessage =
        document.querySelector(
            "#scoreMessage"
        );


    if (scoreValue)
        scoreValue.textContent =
            score;

    if (scoreCircle)
        scoreCircle.style.background =
            `conic-gradient(
                currentColor ${score}%,
                rgba(255,255,255,.08) ${score}%
            )`;


    if (scoreMessage) {

        if (score >= 80) {

            scoreMessage.textContent =
                "Portfolio operating at a high-performance level.";

        } else if (score >= 60) {

            scoreMessage.textContent =
                "Strong progress. Increase evidence quality.";

        } else if (score >= 40) {

            scoreMessage.textContent =
                "Momentum is building. More execution is needed.";

        } else {

            scoreMessage.textContent =
                "Start producing evidence instead of only planning.";
        }
    }


    updateCategoryBars();
}


/* =========================================================
   CATEGORY BARS
   ========================================================= */

function updateCategoryBars() {

    const completed =
        state.missions.length;

    const audit =
        state.auditItems.length;

    const context =
        Math.min(
            completed * 20,
            100
        );

    const execution =
        Math.min(
            Math.max(
                completed - 1,
                0
            ) * 20,
            100
        );

    const production =
        Math.min(
            Math.max(
                completed - 3,
                0
            ) * 25,
            100
        );

    const verification =
        Math.min(
            Math.max(
                completed - 5,
                0
            ) * 34 +
            audit * 10,
            100
        );


    setBar(
        "#contextBar",
        context
    );

    setBar(
        "#executionBar",
        execution
    );

    setBar(
        "#productionBar",
        production
    );

    setBar(
        "#verificationBar",
        verification
    );
}


function setBar(selector, value) {

    const bar =
        document.querySelector(
            selector
        );

    if (bar) {

        bar.style.width =
            value + "%";
    }
}


/* =========================================================
   ACHIEVEMENTS
   ========================================================= */

function updateAchievements() {

    const achievements =
        document.querySelectorAll(
            ".achievement"
        );

    achievements.forEach(
        achievement => {

            achievement.classList.remove(
                "unlocked"
            );
        }
    );

    const unlocks = [

        state.missions.length >= 1,

        state.missions.length >= 4,

        state.xp >= 400,

        state.missions.length >= 6,

        state.missions.length >= 8

    ];

    achievements.forEach(
        (achievement, index) => {

            if (unlocks[index]) {

                achievement.classList.add(
                    "unlocked"
                );
            }
        }
    );
}


/* =========================================================
   LEVELS
   ========================================================= */

function updateLevels() {

    const level =
        Math.min(
            Math.floor(state.xp / 200) + 1,
            5
        );

    document
        .querySelectorAll(
            ".level-card"
        )
        .forEach(
            (card, index) => {

                card.classList.remove(
                    "current",
                    "locked"
                );

                const cardLevel =
                    index + 1;

                if (
                    cardLevel === level
                ) {

                    card.classList.add(
                        "current"
                    );
                }

                if (
                    cardLevel > level
                ) {

                    card.classList.add(
                        "locked"
                    );
                }
            }
        );
}


/* =========================================================
   AUDIT SYSTEM
   ========================================================= */

function setupAudit() {

    document
        .querySelectorAll(
            ".auditCheck"
        )
        .forEach(
            (checkbox, index) => {

                checkbox.addEventListener(
                    "change",
                    function () {

                        const alreadyChecked =
                            state.auditItems.includes(
                                index
                            );

                        if (
                            this.checked &&
                            !alreadyChecked
                        ) {

                            state.auditItems.push(
                                index
                            );

                            addXP(25);

                            recordActivity();

                            toast(
                                "Audit Evidence Added",
                                "+25 XP for documenting another verified condition."
                            );

                        } else if (
                            !this.checked &&
                            alreadyChecked
                        ) {

                            state.auditItems =
                                state.auditItems.filter(
                                    item =>
                                        item !== index
                                );

                            addXP(-25);

                            toast(
                                "Audit Reopened",
                                "The evidence item is no longer counted."
                            );
                        }

                        save();
                        updateAll();
                    }
                );
            }
        );
}


function restoreAudit() {

    document
        .querySelectorAll(
            ".auditCheck"
        )
        .forEach(
            (checkbox, index) => {

                checkbox.checked =
                    state.auditItems.includes(
                        index
                    );
            }
        );
}


/* =========================================================
   7-DAY CHALLENGE
   ========================================================= */

function completeDay(card) {

    const cards =
        Array.from(
            document.querySelectorAll(
                ".challenge-card"
            )
        );

    const index =
        cards.indexOf(card);

    if (index < 0) return;

    if (
        state.challengeDays.includes(
            index
        )
    ) {

        toast(
            "Already Recorded",
            "This challenge step has already been submitted."
        );

        return;
    }

    state.challengeDays.push(
        index
    );

    card.classList.add(
        "done"
    );

    addXP(25);

    recordActivity();

    save();

    updateAll();

    toast(
        "Challenge Step Recorded",
        "+25 XP added."
    );
}


function restoreChallenge() {

    document
        .querySelectorAll(
            ".challenge-card"
        )
        .forEach(
            (card, index) => {

                if (
                    state.challengeDays.includes(
                        index
                    )
                ) {

                    card.classList.add(
                        "done"
                    );
                }
            }
        );
}


function startChallenge() {

    const section =
        document.querySelector(
            "#challenge"
        );

    if (section) {

        section.scrollIntoView({
            behavior: "smooth"
        });
    }

    toast(
        "Sprint Activated",
        "Produce evidence every day. The goal is a record of execution, not intention."
    );
}


/* =========================================================
   FINAL BOSS
   ========================================================= */

function attemptBoss() {

    const score =
        calculateScore();

    const completed =
        state.missions.length;

    const audit =
        state.auditItems.length;

    const challenge =
        state.challengeDays.length;


    const requirements = [];

    if (completed < 8) {

        requirements.push(
            `${8 - completed} more mission submission(s)`
        );
    }

    if (score < 80) {

        requirements.push(
            `score must reach 80 (currently ${score})`
        );
    }

    if (audit < 5) {

        requirements.push(
            `${5 - audit} more audit item(s)`
        );
    }


    if (requirements.length) {

        toast(
            "Final Boss Locked",
            requirements.join(" • ")
        );

        return;
    }


    state.bossDefeated =
        true;

    save();

    updateBoss();

    toast(
        "BOSS DEFEATED",
        "You produced enough evidence to complete the Portfolio Operator system."
    );
}


function updateBoss() {

    const score =
        calculateScore();

    const ready =
        state.missions.length >= 8 &&
        state.auditItems.length >= 5 &&
        score >= 80;

    if (!ready) {

        state.bossDefeated =
            false;
    }

    const buttons =
        document.querySelectorAll(
            "[onclick*='attemptBoss']"
        );

    buttons.forEach(
        button => {

            if (state.bossDefeated) {

                button.textContent =
                    "BOSS DEFEATED ✓";

                button.disabled =
                    true;

            } else {

                button.textContent =
                    "ATTEMPT FINAL BOSS";

                button.disabled =
                    false;
            }
        }
    );
}


