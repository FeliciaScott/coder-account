/* =========================================================
   MISSION RESTORATION
   ========================================================= */

function restoreMissions() {

    document
        .querySelectorAll(
            ".mission-card"
        )
        .forEach(
            (card, index) => {

                const completed =
                    state.missions.includes(
                        index
                    );

                card.classList.toggle(
                    "mission-submitted",
                    completed
                );


                const button =
                    card.querySelector(
                        "button"
                    );

                if (!button) return;


                if (completed) {

                    button.textContent =
                        "VIEW / RESUBMIT EVIDENCE";

                    button.disabled =
                        false;

                } else {

                    button.textContent =
                        "TURN IN WORK";

                    button.disabled =
                        false;
                }


                let status =
                    card.querySelector(
                        ".submission-status"
                    );


                if (completed && !status) {

                    status =
                        document.createElement(
                            "div"
                        );

                    status.className =
                        "submission-status";

                    status.textContent =
                        "✓ EVIDENCE SUBMITTED";

                    card.appendChild(
                        status
                    );
                }


                if (
                    !completed &&
                    status
                ) {

                    status.remove();
                }
            }
        );
}


/* =========================================================
   SUBMISSION HISTORY
   ========================================================= */

function getLatestSubmission(
    missionIndex
) {

    const history =
        state.submissions[
            missionIndex
        ];

    if (
        !Array.isArray(history) ||
        !history.length
    ) {

        return null;
    }

    return history[
        history.length - 1
    ];
}


/* =========================================================
   EVIDENCE REVIEW PANEL
   Can be called from console or future UI.
   ========================================================= */

async function viewSubmission(
    missionIndex
) {

    const submission =
        getLatestSubmission(
            missionIndex
        );

    if (!submission) {

        toast(
            "No Evidence",
            "There is no recorded submission for this mission."
        );

        return;
    }

    if (
        submission.method === "url"
    ) {

        window.open(
            submission.url,
            "_blank",
            "noopener,noreferrer"
        );

        return;
    }

    if (
        submission.method === "upload"
    ) {

        const file =
            await getEvidenceFile(
                submission.fileId
            );

        if (!file) {

            toast(
                "File Missing",
                "The uploaded evidence could not be found."
            );

            return;
        }

        const url =
            URL.createObjectURL(
                file.blob
            );

        window.open(
            url,
            "_blank"
        );

        setTimeout(
            () => URL.revokeObjectURL(url),
            60000
        );

        return;
    }

    if (
        submission.method === "text"
    ) {

        const popup =
            window.open(
                "",
                "_blank"
            );

        if (popup) {

            popup.document.write(`
                <html>
                <head>
                    <title>Portfolio Evidence</title>
                    <style>
                        body{
                            max-width:800px;
                            margin:60px auto;
                            padding:20px;
                            font-family:system-ui;
                            line-height:1.7;
                        }
                        pre{
                            white-space:pre-wrap;
                            font:inherit;
                        }
                    </style>
                </head>
                <body>
                    <h1>Submitted Evidence</h1>
                    <p>
                        Submitted:
                        ${escapeHTML(
                            formatDate(
                                submission.submittedAt
                            )
                        )}
                    </p>
                    <pre>${escapeHTML(
                        submission.text
                    )}</pre>
                </body>
                </html>
            `);

            popup.document.close();
        }
    }
}


/* =========================================================
   ESCAPE HTML
   ========================================================= */

function escapeHTML(value) {

    return String(value ?? "")
        .replace(
            /&/g,
            "&amp;"
        )
        .replace(
            /</g,
            "&lt;"
        )
        .replace(
            />/g,
            "&gt;"
        )
        .replace(
            /"/g,
            "&quot;"
        )
        .replace(
            /'/g,
            "&#039;"
        );
}


/* =========================================================
   FORMATTING
   ========================================================= */

function formatBytes(bytes) {

    if (!bytes) return "0 B";

    const units = [
        "B",
        "KB",
        "MB",
        "GB"
    ];

    const index =
        Math.floor(
            Math.log(bytes) /
            Math.log(1024)
        );

    return (
        Math.round(
            bytes /
            Math.pow(
                1024,
                index
            ) * 10
        ) / 10
    ) +
    " " +
    units[index];
}


function formatDate(date) {

    return new Date(date)
        .toLocaleString(
            undefined,
            {
                dateStyle: "medium",
                timeStyle: "short"
            }
        );
}


