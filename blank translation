                    id="evidenceNotes"
                    placeholder="Tell the reviewer exactly what this link demonstrates..."
                ></textarea>

            </label>

            <div class="evidence-principle">
                Your submission records the URL and the exact
                time you turned it in. The system does not pretend
                that a URL is proof merely because it exists.
            </div>
        `;
